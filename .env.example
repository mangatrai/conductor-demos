# Copy to .env (same folder) and fill in. .env is git-ignored; never commit real keys.

# Which Conductor: "orkes" or "oss". If unset: orkes when CONDUCTOR_AUTH_KEY is set, otherwise oss.
CONDUCTOR_FLAVOR=orkes

# Orkes Conductor: Applications -> your app -> Create access key. The app needs the Worker,
# Metadata API and Business Rule Manager roles.
CONDUCTOR_SERVER_URL=https://<your-cluster>.orkesconductor.io/api
CONDUCTOR_AUTH_KEY=<key id>
CONDUCTOR_AUTH_SECRET=<key secret>

# Conductor OSS (3.34+): no access key. Use instead of the three lines above:
# CONDUCTOR_FLAVOR=oss
# CONDUCTOR_SERVER_URL=http://localhost:8080/api
# Optional, only if the Conductor UI is not at the server URL minus /api (e.g. UI on :5000):
# CONDUCTOR_UI_URL=http://localhost:5000
