# Copy to .env (same folder) and fill in. .env is git-ignored; never commit real keys.
# Orkes: Applications -> your app -> Create access key. The app needs the Worker and Metadata API roles.
CONDUCTOR_SERVER_URL=https://<your-cluster>.orkesconductor.io/api
CONDUCTOR_AUTH_KEY=<key id>
CONDUCTOR_AUTH_SECRET=<key secret>

# dispute_demo: decision table read by the BUSINESS_RULE task (must be a public URL).
# Point it at your own fork's raw URL if you want to edit the rules live.
DISPUTE_RULES_URL=https://raw.githubusercontent.com/mangatrai/conductor-demos/main/dispute_demo/rules/dispute_rules.csv
