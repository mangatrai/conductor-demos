# Copy to .env (git-ignored). Real environment variables always win over this file.
CONDUCTOR_FLAVOR=oss
CONDUCTOR_SERVER_URL=http://localhost:8080/api
# CONDUCTOR_UI_URL=http://localhost:5000
# Orkes instead: CONDUCTOR_FLAVOR=orkes, CONDUCTOR_SERVER_URL=https://<cluster>.orkesconductor.io/api,
# CONDUCTOR_AUTH_KEY=..., CONDUCTOR_AUTH_SECRET=...
CONVO_LLM_PROVIDER=ollama
CONVO_LLM_MODEL=qwen2.5:3b
# native | worker | auto (auto = decided by ./convo.sh checks)
CONVO_LLM_MODE=auto
OLLAMA_URL=http://localhost:11434
