{
  "name": "dispute_intake",
  "description": "One cardholder dispute (one call). Splits into one dispute_case per charge; closes after the last case finishes.",
  "version": 1,
  "schemaVersion": 2,
  "ownerEmail": "dispute-demo@example.com",
  "restartable": true,
  "timeoutPolicy": "ALERT_ONLY",
  "timeoutSeconds": 7776000,
  "inputParameters": [
    "disputeId",
    "cardholderId",
    "items",
    "channel"
  ],
  "tasks": [
    {
      "name": "validate_cardholder",
      "taskReferenceName": "validate_cardholder",
      "type": "SIMPLE",
      "inputParameters": {
        "cardholderId": "${workflow.input.cardholderId}"
      }
    },
    {
      "name": "card_status",
      "taskReferenceName": "card_status",
      "type": "SWITCH",
      "evaluatorType": "value-param",
      "expression": "status",
      "inputParameters": {
        "status": "${validate_cardholder.output.status}"
      },
      "decisionCases": {
        "ACTIVE": []
      },
      "defaultCase": [
        {
          "name": "reject_inactive_card",
          "taskReferenceName": "reject_inactive_card",
          "type": "TERMINATE",
          "inputParameters": {
            "terminationStatus": "TERMINATED",
            "terminationReason": "Card is not active: ${validate_cardholder.output.status}"
          }
        }
      ]
    },
    {
      "name": "prepare_cases",
      "taskReferenceName": "prepare_cases",
      "type": "SIMPLE",
      "inputParameters": {
        "disputeId": "${workflow.input.disputeId}",
        "cardholderId": "${workflow.input.cardholderId}",
        "items": "${workflow.input.items}"
      }
    },
    {
      "name": "notify_cardholder",
      "taskReferenceName": "notify_received",
      "type": "SIMPLE",
      "inputParameters": {
        "cardholderId": "${workflow.input.cardholderId}",
        "kind": "RECEIVED",
        "disputeId": "${workflow.input.disputeId}",
        "data": {
          "caseCount": "${prepare_cases.output.caseCount}",
          "totalDisputed": "${prepare_cases.output.totalDisputed}"
        }
      }
    },
    {
      "name": "case_per_charge",
      "taskReferenceName": "case_per_charge",
      "type": "FORK_JOIN_DYNAMIC",
      "description": "Start one dispute_case sub-workflow per charge; each has its own lifecycle. Optional: a failed case does not cancel its siblings (it is retried by ops and the parent waits for it).",
      "optional": true,
      "inputParameters": {
        "forkTaskWorkflow": "dispute_case",
        "forkTaskWorkflowVersion": "1",
        "forkTaskInputs": "${prepare_cases.output.cases}"
      }
    },
    {
      "name": "wait_for_all_cases",
      "taskReferenceName": "wait_for_all_cases",
      "type": "JOIN"
    },
    {
      "name": "until_all_cases_closed",
      "taskReferenceName": "until_all_cases_closed",
      "type": "DO_WHILE",
      "description": "The parent closes last. The JOIN returns when every case workflow has ended, but a case that failed and is being retried by ops is not closed yet: check the case system and keep waiting (durable timer, no resources used) until every case is closed.",
      "inputParameters": {},
      "loopCondition": "if ($.collect_case_results['pending'] > 0) { true; } else { false; }",
      "loopOver": [
        {
          "name": "collect_case_results",
          "taskReferenceName": "collect_case_results",
          "type": "SIMPLE",
          "inputParameters": {
            "disputeId": "${workflow.input.disputeId}",
            "expectedCount": "${prepare_cases.output.caseCount}"
          }
        },
        {
          "name": "cases_pending",
          "taskReferenceName": "cases_pending",
          "type": "SWITCH",
          "evaluatorType": "graaljs",
          "expression": "$.pending > 0 ? 'WAITING' : 'ALL_CLOSED'",
          "inputParameters": {
            "pending": "${collect_case_results.output.pending}"
          },
          "decisionCases": {
            "WAITING": [
              {
                "name": "recheck_cases",
                "taskReferenceName": "recheck_cases",
                "type": "WAIT",
                "description": "Durable timer before checking again (demo: 30 seconds; production: e.g. 1 hour).",
                "inputParameters": {
                  "duration": "30 seconds"
                }
              }
            ]
          },
          "defaultCase": []
        }
      ]
    },
    {
      "name": "notify_cardholder",
      "taskReferenceName": "notify_summary",
      "type": "SIMPLE",
      "inputParameters": {
        "cardholderId": "${workflow.input.cardholderId}",
        "kind": "DISPUTE_SUMMARY",
        "disputeId": "${workflow.input.disputeId}",
        "data": "${collect_case_results.output}"
      }
    }
  ],
  "outputParameters": {
    "disputeId": "${workflow.input.disputeId}",
    "summary": "${collect_case_results.output}"
  }
}
